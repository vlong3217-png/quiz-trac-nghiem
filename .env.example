# ==============================================================
# HỆ THỐNG THI TRẮC NGHIỆM - BIẾN MÔI TRƯỜNG DOCKER & BACKEND
# ==============================================================

# Backend Port
PORT=5000

# Database Configuration (Docker MySQL service name is 'mysql')
DB_HOST=mysql
DB_PORT=3306
DB_NAME=quiz_system
# Application user (least-privilege account, not root)
DB_USER=quiz_user
DB_PASSWORD=your_strong_app_password
# MySQL root administration password
DB_ROOT_PASSWORD=your_strong_root_password

# JWT Authentication Secret Key (Generate a random 32+ char secret for production)
JWT_SECRET=your_random_super_secret_jwt_key_here

# Public Exposed Ports
FRONTEND_PORT=80
BACKEND_PORT=5000
PMA_PORT=8088
MYSQL_PORT=3308

# Monitoring Ports & Credentials (COMMIT 2: Prometheus & Grafana)
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Logging Configuration (COMMIT 3: Loki & Promtail)
LOKI_PORT=3101
