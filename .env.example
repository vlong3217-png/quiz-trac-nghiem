# Backend Port
PORT=5000

# Database Configuration (Docker MySQL service name is 'mysql')
DB_HOST=mysql
DB_PORT=3306
DB_NAME=quiz_system
DB_USER=root
DB_PASSWORD=your_secure_db_password
